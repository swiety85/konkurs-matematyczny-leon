{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LeonTask",
  "type": "object",
  "required": ["id", "klasa", "dzial", "typ", "tresc", "opcje", "poprawne", "wyjasnienie", "zrodlo", "trudnosc"],
  "properties": {
    "id": { "type": "string", "description": "Unikalny identyfikator, np. k3-w25-01" },
    "klasa": { "type": "integer", "minimum": 1, "maximum": 8 },
    "dzial": {
      "type": "string",
      "enum": [
        "liczby-ciagi",
        "dodawanie-odejmowanie",
        "mnozenie-dzielenie",
        "podzielnosc",
        "zadania-tekstowe",
        "czas-miary",
        "geometria",
        "logika",
        "liczby-wielocyfrowe",
        "kolejnosc-dzialan",
        "ulamki",
        "pola-jednostki"
      ]
    },
    "typ": { "type": "string", "enum": ["single", "multi", "none", "open"] },
    "tresc": { "type": "string" },
    "opcje": {
      "type": "object",
      "properties": {
        "A": { "type": "string" },
        "B": { "type": "string" },
        "C": { "type": "string" },
        "D": { "type": "string" }
      }
    },
    "poprawne": {
      "type": "array",
      "items": { "type": "string", "enum": ["A", "B", "C", "D"] },
      "description": "Puste = żadna odpowiedź nie jest poprawna (typ none)"
    },
    "wyjasnienie": { "type": "string" },
    "zrodlo": { "type": "string" },
    "trudnosc": { "type": "integer", "minimum": 1, "maximum": 3 },
    "hint": { "type": "string" },
    "openAnswer": { "type": "string" },
    "seedId": { "type": "string", "description": "Stabilny klucz seeda (zadania generowane)" },
    "pool": { "type": "string", "enum": ["learn", "quiz", "exam"], "description": "Jawna pula trybu" },
    "variant": { "type": "integer", "minimum": 0, "description": "0 = parafraza exam, 1..n = warianty" },
    "archiveRef": {
      "type": "object",
      "required": ["sheet", "number"],
      "properties": {
        "sheet": { "type": "string" },
        "number": { "type": "integer", "minimum": 1 }
      }
    },
    "illustration": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "type": "string", "enum": ["clock", "shapes", "domino", "number-line", "bars", "grid"] }
      }
    }
  }
}
